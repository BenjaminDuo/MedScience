{
  "name": "medscience-monorepo",
  "private": true,
  "version": "1.4.0",
  "description": "MedScience - Autonomous Scientific Research Workstation",
  "author": "MedScience Team <team@medscience.org>",
  "repository": {
    "type": "git",
    "url": "https://github.com/BenjaminDuo/MedScience.git"
  },
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build:core": "npm --workspace=@medscience/core run build",
    "build:desktop": "npm --workspace=@medscience/desktop run build",
    "build:cli": "npm --workspace=@medscience/cli run build",
    "build:web": "npm --workspace=@medscience/web run build",
    "build": "npm run build:core && npm run build:cli && npm run build:desktop && npm run build:web",
    "test:core": "npm --workspace=@medscience/core test",
    "test:cli": "npm --workspace=@medscience/cli test",
    "test:desktop": "npm --workspace=@medscience/desktop test",
    "test": "npm run test:core && npm run test:cli && npm run test:desktop",
    "cli": "node packages/cli/bin/medscience.js",
    "desktop": "npx electron packages/desktop/dist-electron/main.js",
    "desktop:dev": "npm --workspace=@medscience/desktop run dev",
    "web": "npm run build:core && npm --workspace=@medscience/desktop run build:renderer && npm run build:web && node packages/web/bin/medscience-web.js",
    "web:dev": "npm run build:core && npm run build:web && node packages/web/bin/medscience-web.js --dev",
    "dist:mac": "node node_modules/electron-builder/cli.js --mac --project packages/desktop -c electron-builder.json --publish never",
    "dist:win": "node node_modules/electron-builder/cli.js --win --project packages/desktop -c electron-builder.json --publish never",
    "portal:dev": "npm --workspace=@medscience/portal run dev",
    "portal:preview": "npm --workspace=@medscience/portal run preview",
    "portal:build": "npm --workspace=@medscience/portal run build"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "electron": "28.3.3",
    "electron-builder": "24.13.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}

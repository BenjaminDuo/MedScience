{
  "appId": "com.medscience.desktop",
  "productName": "MedScience",
  "executableName": "medscience",
  "electronVersion": "28.3.3",
  "npmRebuild": false,
  "nodeGypRebuild": false,
  "beforeBuild": "./scripts/beforeBuild.cjs",
  "directories": {
    "output": "release"
  },
  "publish": {
    "provider": "github",
    "owner": "BenjaminDuo",
    "repo": "MedScience"
  },
  "files": [
    "dist/**/*",
    "dist-electron/**/*",
    "package.json"
  ],
  "mac": {
    "category": "public.app-category.education",
    "identity": null,
    "target": [
      {
        "target": "dmg",
        "arch": [
          "x64",
          "arm64"
        ]
      },
      {
        "target": "zip",
        "arch": [
          "x64",
          "arm64"
        ]
      }
    ],
    "hardenedRuntime": false,
    "gatekeeperAssess": false
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      },
      {
        "target": "zip",
        "arch": [
          "x64"
        ]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true
  },
  "linux": {
    "category": "Science;Education",
    "maintainer": "MedScience Team <team@medscience.org>",
    "icon": "build/icons",
    "synopsis": "Autonomous scientific research workstation",
    "description": "MedScience is an open-source biomedical research workstation: evidence-verified research runs, hardened molecular and clinical connectors, and a kernel-enforced Python sandbox.",
    "desktop": {
      "Keywords": "science;biomedical;research;bioinformatics;agent;"
    },
    "target": [
      {
        "target": "AppImage",
        "arch": [
          "x64"
        ]
      },
      {
        "target": "deb",
        "arch": [
          "x64"
        ]
      }
    ]
  },
  "appImage": {
    "artifactName": "MedScience-${version}.${ext}"
  },
  "deb": {
    "artifactName": "medscience_${version}_${arch}.${ext}"
  }
}

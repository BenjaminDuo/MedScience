# Dependencies
node_modules/
.pnp/
.pnp.js

# Build Outputs
dist/
dist-electron/
release/
build/
# ...but not the desktop app's build resources, which are source, not output:
# electron-builder reads the app icon out of here to derive the macOS .icns,
# the Windows .ico and the Linux hicolor set. Swept up by build/ above, they
# would be missing on a fresh clone and every packaged build would silently
# fall back to the default Electron icon.
!packages/desktop/build/
*.tsbuildinfo
packages/*/src/**/*.js
packages/*/src/**/*.js.map
packages/*/src/**/*.d.ts
packages/*/src/**/*.d.ts.map
# ...but not hand-written ambient declarations, which live beside the
# source they describe and are not build output.
!packages/*/src/vite-env.d.ts

# Upstream Reference Repositories
upstream/

# Environment & Credentials
.env
.env.*
*.env
*.env.*
.env.local
.env.*.local
*.pem
*.key
*.cert
*.crt
id_rsa*
id_ed25519*
*credentials*.json
*secret*.json
*.token
*.auth

# Runtime & Sandboxes
.medscience/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS Files
.DS_Store
Thumbs.db

# IDE & Editor
.idea/
.vscode/
*.swp
*.swo
